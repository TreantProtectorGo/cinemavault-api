        "type": "object",
        "required": ["data", "pagination", "links"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Film" } },
          "pagination": {
            "type": "object",
            "properties": {
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total": { "type": "integer" },
              "totalPages": { "type": "integer" }
            }
          },
          "links": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "OmdbImportRequest": {
        "type": "object",
        "properties": {
          "imdbId": { "type": "string" },
          "title": { "type": "string" }
        },
        "description": "Supply either imdbId or title."
      },
      "Favourite": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "filmId": { "type": "string" },
          "film": { "$ref": "#/components/schemas/Film" },
          "createdAt": { "type": "string", "format": "date-time" },
          "links": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "WatchlistItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "filmId": { "type": "string" },
          "status": { "type": "string" },
          "notes": { "type": "string", "nullable": true },
          "film": { "$ref": "#/components/schemas/Film" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "links": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "WatchedRecord": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "filmId": { "type": "string" },
          "watchedAt": { "type": "string", "format": "date-time" },
          "rating": { "type": "integer", "nullable": true },
          "reviewNote": { "type": "string", "nullable": true },
          "film": { "$ref": "#/components/schemas/Film" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "links": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
