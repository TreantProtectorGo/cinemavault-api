{
  "openapi": "3.0.3",
  "info": {
    "title": "CinemaVault API",
    "version": "0.7.0",
    "description": "Secure film discovery REST API for Coventry University 6003CEM CW2. It includes JWT authentication, RBAC, Basic Auth evidence, public film browsing, tracking records, direct messages, OMDB import, profile photo upload, and OpenAPI documentation.",
    "contact": {
      "name": "CinemaVault coursework maintainer",
      "email": "placeholder@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Profile" },
    { "name": "Admin" },
    { "name": "Films" },
    { "name": "Favourites" },
    { "name": "Watchlist" },
    { "name": "Watched" },
    { "name": "Messages" }
  ],
  "paths": {
    "/api-docs": {
      "get": {
        "tags": ["Health"],
        "summary": "Serve the API documentation UI",
        "responses": {
          "200": {
            "description": "Redoc HTML documentation page",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api-docs/openapi.json": {
      "get": {
        "tags": ["Health"],
        "summary": "Serve the raw OpenAPI JSON document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.x JSON",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Public health check",
        "responses": {
          "200": {
            "description": "API is available",
            "content": {
              "application/json": {
                "example": { "status": "ok", "service": "cinemavault-api" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a public user",
        "description": "Public registration always creates a normal USER account. Administrator accounts are provisioned internally and cannot be created through this endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRegisterRequest" },
              "example": {
                "email": "member@example.com",
                "username": "member",
                "password": "StrongPassword123!",
                "displayName": "Cinema Member"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered user with JWT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login and receive a JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthLoginRequest" },
              "example": {
                "emailOrUsername": "member@example.com",
                "password": "StrongPassword123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/auth/google": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login or register a public user with Google OAuth",
        "description": "Verifies a Google OAuth ID token and returns the normal CinemaVault JWT response. External authentication is public-user only: it never creates administrator accounts and rejects existing administrator emails.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthGoogleRequest" },
              "example": {
                "credential": "google-id-token-from-google-identity-services"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Google OAuth login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "External authentication cannot be used for administrator accounts",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/auth/basic-check": {
      "get": {
        "tags": ["Auth"],
        "summary": "Coursework Basic Auth evidence endpoint",
        "security": [{ "BasicAuth": [] }],
        "responses": {
          "200": {
            "description": "Basic Auth credentials are valid",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "auth": "basic",
                  "user": {
                    "id": "clw123",
                    "username": "member",
                    "email": "member@example.com",
                    "role": "USER"
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": ["Profile"],
        "summary": "Return the authenticated user's public profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/UserPublicResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["Profile"],
        "summary": "Update safe authenticated user profile fields",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileUpdateRequest" },
              "example": {
                "displayName": "Cinema Member",
                "profilePhotoUrl": "https://example.com/avatar.png"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/UserPublicResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/me/profile-photo": {
      "post": {
        "tags": ["Profile"],
        "summary": "Upload a profile photo for the authenticated user",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/ProfilePhotoUploadRequest" },
              "encoding": {
                "profilePhoto": {
                  "contentType": "image/jpeg, image/png, image/webp"
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/UserPublicResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/ping": {
      "get": {
        "tags": ["Admin"],
        "summary": "Admin-only RBAC verification",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Admin token accepted",
            "content": {
              "application/json": {
                "example": { "status": "ok", "role": "ADMIN" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/films": {
      "get": {
        "tags": ["Films"],
        "summary": "Browse, search, filter, sort, and paginate live films",
        "parameters": [
          { "name": "title", "in": "query", "schema": { "type": "string" } },
          { "name": "genre", "in": "query", "schema": { "type": "string" } },
          { "name": "year", "in": "query", "schema": { "type": "integer" } },
          { "name": "rating", "in": "query", "schema": { "type": "number" } },
          { "name": "isLive", "in": "query", "schema": { "type": "boolean" } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["title", "genre", "year", "rating", "createdAt", "updatedAt"] } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Film list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FilmListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Films"],
        "summary": "Create a film manually",
        "description": "Creates a film record. If the new film is created with isLive=true, the API triggers the configured administrator social feed publisher with basic film details.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FilmCreateRequest" },
              "example": {
                "title": "Inception",
                "genre": "Sci-Fi",
                "year": 2010,
                "rating": 8.8,
                "director": "Christopher Nolan",
                "isLive": true
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/FilmResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/films/import-omdb": {
      "post": {
        "tags": ["Films"],
        "summary": "Import or update a film from OMDB",
        "description": "Imports film metadata from OMDB and creates or updates the local Film record. Imported films are made live by default; if this makes a new or draft film live, the API triggers the configured administrator social feed publisher.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OmdbImportRequest" },
              "examples": {
                "byImdbId": { "value": { "imdbId": "tt0133093" } },
                "byTitle": { "value": { "title": "The Matrix" } }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/FilmResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "502": { "$ref": "#/components/responses/BadGateway" }
        }
      }
    },
    "/api/v1/films/{id}": {
      "get": {
        "tags": ["Films"],
        "summary": "Get one film by id",
        "description": "Returns ETag and Last-Modified headers. If the client sends a matching If-None-Match or If-Modified-Since header, the API returns 304 Not Modified.",
        "parameters": [{ "$ref": "#/components/parameters/FilmId" }],
        "responses": {
          "200": {
            "description": "Film response",
            "headers": {
              "ETag": {
                "description": "Weak entity tag for conditional requests",
                "schema": { "type": "string" }
              },
              "Last-Modified": {
                "description": "Last film update time in HTTP date format",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Film" }
              }
            }
          },
          "304": {
            "description": "Film has not changed since the supplied request validator"
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["Films"],
        "summary": "Update a film",
        "description": "Updates a film record. If this changes isLive from false to true, the API triggers the configured administrator social feed publisher with basic film details.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FilmUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/FilmResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Films"],
        "summary": "Soft-delete a film",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/FilmResponse" },
          "204": { "description": "Deleted with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/favourites": {
      "get": {
        "tags": ["Favourites"],
        "summary": "List current user's favourite films",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/favourites/{filmId}": {
      "post": {
        "tags": ["Favourites"],
        "summary": "Add a film to favourites",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/FavouriteResponse" },
          "201": { "$ref": "#/components/responses/FavouriteResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Favourites"],
        "summary": "Remove a film from favourites",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/FavouriteResponse" },
          "204": { "description": "Removed with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watchlist": {
      "get": {
        "tags": ["Watchlist"],
        "summary": "List current user's watchlist",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watchlist/{filmId}": {
      "post": {
        "tags": ["Watchlist"],
        "summary": "Add a film to watchlist",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/WatchlistResponse" },
          "201": { "$ref": "#/components/responses/WatchlistResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Watchlist"],
        "summary": "Remove a film from watchlist",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/WatchlistResponse" },
          "204": { "description": "Removed with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watched": {
      "get": {
        "tags": ["Watched"],
        "summary": "List current user's watched records",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watched/{filmId}": {
      "post": {
        "tags": ["Watched"],
        "summary": "Mark a film as watched",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rating": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "notes": { "type": "string" }
                }
              },
              "example": { "rating": 9, "notes": "Strong first contact story." }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/WatchedResponse" },
          "201": { "$ref": "#/components/responses/WatchedResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Watched"],
        "summary": "Remove a watched record",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/WatchedResponse" },
          "204": { "description": "Removed with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/messages": {
      "get": {
        "tags": ["Messages"],
        "summary": "List current user's messages and replies",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["OPEN", "REPLIED", "DELETED"] } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Messages"],
        "summary": "Send a direct message to admin about a film",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessageCreateRequest" },
              "example": {
                "filmId": "clwfilm123",
                "subject": "Screening question",
                "body": "Will this film be available in the weekend showcase?"
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/MessageResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/messages": {
      "get": {
        "tags": ["Messages", "Admin"],
        "summary": "Admin list of all messages",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["OPEN", "REPLIED", "DELETED"] } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/messages/{id}/reply": {
      "post": {
        "tags": ["Messages", "Admin"],
        "summary": "Admin reply to a message",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MessageId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessageReplyRequest" },
              "example": { "replyBody": "Yes, it is scheduled for Saturday." }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/messages/{id}": {
      "delete": {
        "tags": ["Messages", "Admin"],
        "summary": "Admin soft-delete a message",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MessageId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/MessageResponse" },
          "204": { "description": "Deleted with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
