          "genre": { "type": "string" },
          "year": { "type": "integer", "minimum": 1888, "maximum": 2100 },
          "rating": { "type": "number", "minimum": 0, "maximum": 10 },
          "director": { "type": "string" },
          "cast": { "type": "string" },
          "plot": { "type": "string" },
          "posterUrl": { "type": "string", "format": "uri" },
          "runtime": { "type": "integer" },
          "language": { "type": "string" },
          "country": { "type": "string" },
          "imdbId": { "type": "string" },
          "omdbMetadataJson": { "type": "string" },
          "isLive": { "type": "boolean" }
        }
      },
