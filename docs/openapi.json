{
  "openapi": "3.0.3",
  "info": {
    "title": "CinemaVault API",
    "version": "0.6.0",
    "description": "Secure film discovery REST API for Coventry University 6003CEM CW2. It includes JWT authentication, RBAC, Basic Auth evidence, public film browsing, tracking records, direct messages, OMDB import, and OpenAPI documentation.",
    "contact": {
      "name": "CinemaVault coursework maintainer",
      "email": "placeholder@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Admin" },
    { "name": "Films" },
    { "name": "Favourites" },
    { "name": "Watchlist" },
    { "name": "Watched" },
    { "name": "Messages" }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Public health check",
        "responses": {
          "200": {
            "description": "API is available",
            "content": {
              "application/json": {
                "example": { "status": "ok", "service": "cinemavault-api" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a user or admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRegisterRequest" },
              "example": {
                "email": "member@example.com",
                "username": "member",
                "password": "StrongPassword123!",
                "displayName": "Cinema Member"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered user with JWT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login and receive a JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthLoginRequest" },
              "example": {
                "emailOrUsername": "member@example.com",
                "password": "StrongPassword123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/auth/basic-check": {
      "get": {
        "tags": ["Auth"],
        "summary": "Coursework Basic Auth evidence endpoint",
        "security": [{ "BasicAuth": [] }],
        "responses": {
          "200": {
            "description": "Basic Auth credentials are valid",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "auth": "basic",
                  "user": {
                    "id": "clw123",
                    "username": "member",
                    "email": "member@example.com",
                    "role": "USER"
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/ping": {
      "get": {
        "tags": ["Admin"],
        "summary": "Admin-only RBAC verification",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Admin token accepted",
            "content": {
              "application/json": {
                "example": { "status": "ok", "role": "ADMIN" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/films": {
      "get": {
        "tags": ["Films"],
        "summary": "Browse, search, filter, sort, and paginate live films",
        "parameters": [
          { "name": "title", "in": "query", "schema": { "type": "string" } },
          { "name": "genre", "in": "query", "schema": { "type": "string" } },
          { "name": "year", "in": "query", "schema": { "type": "integer" } },
          { "name": "rating", "in": "query", "schema": { "type": "number" } },
          { "name": "isLive", "in": "query", "schema": { "type": "boolean" } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["title", "genre", "year", "rating", "createdAt", "updatedAt"] } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Film list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FilmListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Films"],
        "summary": "Create a film manually",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FilmCreateRequest" },
              "example": {
                "title": "Inception",
                "genre": "Sci-Fi",
                "year": 2010,
                "rating": 8.8,
                "director": "Christopher Nolan",
                "isLive": true
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/FilmResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/films/import-omdb": {
      "post": {
        "tags": ["Films"],
        "summary": "Import or update a film from OMDB",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OmdbImportRequest" },
              "examples": {
                "byImdbId": { "value": { "imdbId": "tt0133093" } },
                "byTitle": { "value": { "title": "The Matrix" } }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/FilmResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "502": { "$ref": "#/components/responses/BadGateway" }
        }
      }
    },
    "/api/v1/films/{id}": {
      "get": {
        "tags": ["Films"],
        "summary": "Get one film by id",
        "parameters": [{ "$ref": "#/components/parameters/FilmId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/FilmResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["Films"],
        "summary": "Update a film",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FilmUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/FilmResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Films"],
        "summary": "Soft-delete a film",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/FilmResponse" },
          "204": { "description": "Deleted with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/favourites": {
      "get": {
        "tags": ["Favourites"],
        "summary": "List current user's favourite films",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/favourites/{filmId}": {
      "post": {
        "tags": ["Favourites"],
        "summary": "Add a film to favourites",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/FavouriteResponse" },
          "201": { "$ref": "#/components/responses/FavouriteResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Favourites"],
        "summary": "Remove a film from favourites",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/FavouriteResponse" },
          "204": { "description": "Removed with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watchlist": {
      "get": {
        "tags": ["Watchlist"],
        "summary": "List current user's watchlist",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watchlist/{filmId}": {
      "post": {
        "tags": ["Watchlist"],
        "summary": "Add a film to watchlist",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/WatchlistResponse" },
          "201": { "$ref": "#/components/responses/WatchlistResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Watchlist"],
        "summary": "Remove a film from watchlist",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/WatchlistResponse" },
          "204": { "description": "Removed with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watched": {
      "get": {
        "tags": ["Watched"],
        "summary": "List current user's watched records",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/watched/{filmId}": {
      "post": {
        "tags": ["Watched"],
        "summary": "Mark a film as watched",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rating": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "notes": { "type": "string" }
                }
              },
              "example": { "rating": 9, "notes": "Strong first contact story." }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/WatchedResponse" },
          "201": { "$ref": "#/components/responses/WatchedResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Watched"],
        "summary": "Remove a watched record",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FilmIdParam" }],
        "responses": {
          "200": { "$ref": "#/components/responses/WatchedResponse" },
          "204": { "description": "Removed with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/messages": {
      "get": {
        "tags": ["Messages"],
        "summary": "List current user's messages and replies",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["OPEN", "REPLIED", "DELETED"] } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Messages"],
        "summary": "Send a direct message to admin about a film",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessageCreateRequest" },
              "example": {
                "filmId": "clwfilm123",
                "subject": "Screening question",
                "body": "Will this film be available in the weekend showcase?"
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/MessageResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/messages": {
      "get": {
        "tags": ["Messages", "Admin"],
        "summary": "Admin list of all messages",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["OPEN", "REPLIED", "DELETED"] } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CollectionResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/messages/{id}/reply": {
      "post": {
        "tags": ["Messages", "Admin"],
        "summary": "Admin reply to a message",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MessageId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessageReplyRequest" },
              "example": { "replyBody": "Yes, it is scheduled for Saturday." }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MessageResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/admin/messages/{id}": {
      "delete": {
        "tags": ["Messages", "Admin"],
        "summary": "Admin soft-delete a message",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MessageId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/MessageResponse" },
          "204": { "description": "Deleted with no response body" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "FilmId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "FilmIdParam": {
        "name": "filmId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "MessageId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unauthorized": {
        "description": "Authentication required or invalid",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "Authenticated user lacks the required role",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Conflict": {
        "description": "Duplicate resource conflict",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalServerError": {
        "description": "Unexpected server error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "BadGateway": {
        "description": "External OMDB API failed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "FilmResponse": {
        "description": "Film response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Film" } } }
      },
      "FavouriteResponse": {
        "description": "Favourite response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Favourite" } } }
      },
      "WatchlistResponse": {
        "description": "Watchlist item response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchlistItem" } } }
      },
      "WatchedResponse": {
        "description": "Watched record response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchedRecord" } } }
      },
      "MessageResponse": {
        "description": "Message response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } }
      },
      "CollectionResponse": {
        "description": "Collection response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": { "type": "array", "items": { "type": "object" } },
                "links": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "UserPublic": {
        "type": "object",
        "required": ["id", "email", "username", "role", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "username": { "type": "string" },
          "role": { "type": "string", "enum": ["USER", "ADMIN"] },
          "displayName": { "type": "string", "nullable": true },
          "profilePhotoUrl": { "type": "string", "format": "uri", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthRegisterRequest": {
        "type": "object",
        "required": ["email", "username", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "username": { "type": "string", "minLength": 3 },
          "password": { "type": "string", "minLength": 8 },
          "displayName": { "type": "string" },
          "profilePhotoUrl": { "type": "string", "format": "uri" },
          "role": { "type": "string", "enum": ["USER", "ADMIN"] }
        }
      },
      "AuthLoginRequest": {
        "type": "object",
        "required": ["emailOrUsername", "password"],
        "properties": {
          "emailOrUsername": { "type": "string" },
          "password": { "type": "string" }
        }
      },
