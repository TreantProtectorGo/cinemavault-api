          "subject": { "type": "string" },
          "body": { "type": "string" },
          "replyBody": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["OPEN", "REPLIED", "DELETED"] },
          "sender": { "$ref": "#/components/schemas/UserPublic" },
          "film": { "$ref": "#/components/schemas/Film" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "repliedAt": { "type": "string", "format": "date-time", "nullable": true },
          "deletedAt": { "type": "string", "format": "date-time", "nullable": true },
          "links": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "MessageCreateRequest": {
        "type": "object",
        "required": ["filmId", "subject", "body"],
        "properties": {
          "filmId": { "type": "string" },
          "subject": { "type": "string" },
