generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  username        String           @unique
  passwordHash    String
  role            String           @default("USER")
  displayName     String?
  profilePhotoUrl String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  favourites      Favourite[]
  watchlistItems  WatchlistItem[]
  watchedRecords  WatchedRecord[]
  messages        Message[]        @relation("UserMessages")
  adminReplies    Message[]        @relation("AdminMessageReplies")

  @@index([role])
}

model Film {
  id               String           @id @default(cuid())
  title            String
  genre            String?
  year             Int?
  rating           Float?
  director         String?
  cast             String?
  plot             String?
  posterUrl        String?
  runtime          Int?
  language         String?
  country          String?
  imdbId           String?          @unique
  omdbMetadataJson String?
  isLive           Boolean          @default(false)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  favourites       Favourite[]
  watchlistItems   WatchlistItem[]
  watchedRecords   WatchedRecord[]
  messages         Message[]

  @@index([isLive])
  @@index([deletedAt])
  @@index([title])
  @@index([genre])
  @@index([year])
  @@index([rating])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([filmId])
}

model WatchlistItem {
  id        String          @id @default(cuid())
  userId    String
  filmId    String
  status    String          @default("PLANNED")
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  film      Film            @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([filmId])
  @@index([status])
}

model WatchedRecord {
  id         String   @id @default(cuid())
  userId     String
  filmId     String
  watchedAt  DateTime @default(now())
  rating     Int?
  reviewNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  film       Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([userId])
  @@index([filmId])
  @@index([watchedAt])
}

model Message {
  id          String        @id @default(cuid())
  userId      String
  filmId      String
  adminId     String?
  subject     String
  body        String
  replyBody   String?
  status      String        @default("OPEN")
  repliedAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)
  admin       User?         @relation("AdminMessageReplies", fields: [adminId], references: [id], onDelete: SetNull)
  film        Film          @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
  @@index([filmId])
  @@index([status])
  @@index([deletedAt])
}
